# ============================================================
# COPY file ini jadi .env, lalu isi value-nya
# cp .env.example .env
# ============================================================

# AI — Anthropic SDK via z.ai proxy
ANTHROPIC_API_KEY=isikan_dengan_api_key_lo
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
AI_MODEL=claude-sonnet-4-20250514

# Notion — dapet dari https://www.notion.so/my-integrations
NOTION_API_KEY=isikan_dengan_notion_integration_token
NOTION_DATABASE_ID=isikan_dengan_database_id
NOTION_MASTER_BACKLOG_ID=isikan_dengan_master_backlog_id
NOTION_MASTER_PROJECTS_ID=isikan_dengan_master_projects_id
NOTION_DIVISIONS_ID=isikan_dengan_divisions_id
NOTION_MEMBERS_ID=isikan_dengan_members_id
NOTION_VERSION=2022-06-28

# Evolution API
EVOLUTION_API_KEY=isikan_dengan_api_key_evolution
EVOLUTION_INSTANCE_NAME=wa-bot

# Cloudflare Tunnel (public URL)
# Setelah setup tunnel, isi dengan domain yang di-route
PUBLIC_URL=https://wa-bot.rpllearn.site

# Optional port overrides
# ORCHESTRATOR_PORT=3000
# EVOLUTION_PORT=8080
# REDIS_PORT=6379
# POSTGRES_PASSWORD=evolution123
